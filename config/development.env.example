# Copy to config/development.env on the development VM.

HAPAPP_HOST=0.0.0.0
HAPAPP_PORT=8050
HAPAPP_DEBUG=0
APP_ENV=development
SECRET_KEY=change-me
TLS_ENABLED=true
TLS_CERT_PATH=/cert.pem
TLS_KEY_PATH=/key.pem

# Fine-grained token: Contents read/write on every configured species repository.
HAPAPP_GITHUB_TOKEN=
HAPAPP_TEST_ALFALFA_PANEL_REPO=https://github.com/tylerslonecki/test_alfalfa_haplotype_db

# HAPAPP_PANELS_FILE=/absolute/path/to/panels.toml

HAPAPP_DROPBOX_APP_KEY=
HAPAPP_DROPBOX_APP_SECRET=
HAPAPP_DROPBOX_REFRESH_TOKEN=
HAPAPP_DROPBOX_ACCESS_TOKEN=
HAPAPP_DROPBOX_MADC_FOLDER=/HapApp/MADC review/development
HAPAPP_DROPBOX_LOG_FOLDER=/HapApp/MADC logs/development

HAPAPP_DATASTORE=firestore
HAPAPP_DATASTORE_PREFLIGHT=true
GOOGLE_CLOUD_PROJECT=your-development-project-id
FIRESTORE_DATABASE=hapapp-db
HAPAPP_GITHUB_PUBLISHING_RECOVERY_ENABLED=true
HAPAPP_GITHUB_PUBLISHING_RECOVERY_AGE_SECONDS=3600

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
