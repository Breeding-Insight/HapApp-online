# Non-secret Cloud Run environment variables. Configure these on the service;
# store credentials listed below in Secret Manager rather than this file.
APP_ENV=production
HAPAPP_ENV_FROM_PROCESS=1
# Optional after the first deployment. When omitted, trusted Cloud Run proxy
# headers provide the HTTPS service URL used by the ORCID callback.
HAPAPP_PUBLIC_URL=
TLS_ENABLED=false
HAPAPP_DATABASE_PREFLIGHT=true
HAPAPP_GITHUB_PUBLISHING_RECOVERY_ENABLED=true
HAPAPP_GITHUB_PUBLISHING_RECOVERY_AGE_SECONDS=3600

# Use the private IP of a dedicated Cloud SQL for SQL Server instance.
MSSQL_SERVER=10.0.0.10
MSSQL_PORT=1433
MSSQL_DATABASE=HapApp
MSSQL_USER=hapapp_runtime_user
MSSQL_DRIVER=/app/.pixi/envs/default/lib/libtdsodbc.so
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Repository that owns the published species database.
HAPAPP_TEST_ALFALFA_PANEL_REPO=https://github.com/YOUR-ORG/YOUR-SPECIES-REPOSITORY

HAPAPP_DROPBOX_MADC_FOLDER=/HapApp/MADC review/cloud-run
HAPAPP_DROPBOX_LOG_FOLDER=/HapApp/MADC logs/cloud-run

# Configure these as Secret Manager environment variables:
# SECRET_KEY
# MSSQL_PASSWORD
# ORCID_CLIENT_ID
# ORCID_CLIENT_SECRET
# HAPAPP_GITHUB_TOKEN
# HAPAPP_DROPBOX_APP_KEY
# HAPAPP_DROPBOX_APP_SECRET
# HAPAPP_DROPBOX_REFRESH_TOKEN
