# Copy to config/local.env for local Pixi or Docker Compose development.

HAPAPP_HOST=0.0.0.0
HAPAPP_PORT=8050
HAPAPP_DEBUG=1
APP_ENV=local-dev
SECRET_KEY=change-me
HAPAPP_LOCAL_AUTH_BYPASS=1
# HAPAPP_LOCAL_USER_ORCID_ID=local-dev-user
# HAPAPP_LOCAL_USER_NAME=Local Developer
# HAPAPP_LOCAL_USER_ROLE=user

HAPAPP_GITHUB_TOKEN=
HAPAPP_TEST_ALFALFA_PANEL_REPO=https://github.com/tylerslonecki/test_alfalfa_haplotype_db

# HAPAPP_PANELS_FILE=/absolute/path/to/panels.toml

# Preferred Dropbox setup: configure a refresh token once so HapApp can request
# short-lived access tokens automatically. HAPAPP_DROPBOX_ACCESS_TOKEN is only
# a temporary local-dev override.
HAPAPP_DROPBOX_APP_KEY=
HAPAPP_DROPBOX_APP_SECRET=
HAPAPP_DROPBOX_REFRESH_TOKEN=
HAPAPP_DROPBOX_ACCESS_TOKEN=
HAPAPP_DROPBOX_MADC_FOLDER=/HapApp/MADC review/local
HAPAPP_DROPBOX_LOG_FOLDER=/HapApp/MADC logs/local

MSSQL_SERVER=host.docker.internal
MSSQL_PORT=11433
MSSQL_DATABASE=HaploSearch
MSSQL_USER=hapapp_runtime_user
MSSQL_PASSWORD=
MSSQL_DRIVER=/app/.pixi/envs/default/lib/libtdsodbc.so
MSSQL_TRUST_SERVER_CERTIFICATE=true

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
