# Copy to config/production.env on the production VM.

HAPAPP_HOST=0.0.0.0
HAPAPP_PORT=8050
HAPAPP_DEBUG=0
APP_ENV=production
SECRET_KEY=change-me

HAPAPP_GITHUB_TOKEN=
HAPAPP_TEST_ALFALFA_PANEL_REPO=https://github.com/tylerslonecki/test_alfalfa_haplotype_db

# HAPAPP_PANELS_FILE=/absolute/path/to/panels.toml

HAPAPP_DROPBOX_ACCESS_TOKEN=
HAPAPP_DROPBOX_MADC_FOLDER=/HapApp/MADC review/production
HAPAPP_DROPBOX_LOG_FOLDER=/HapApp/MADC logs/production

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=HaploSearch
MSSQL_USER=hapapp_runtime_user
MSSQL_PASSWORD=
MSSQL_DRIVER=/app/.pixi/envs/default/lib/libtdsodbc.so
MSSQL_TRUST_SERVER_CERTIFICATE=true

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
