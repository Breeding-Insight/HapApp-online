# Copy this file to .env on the server and fill in deployment-specific values.
# Do not commit .env.

# App server settings
HAPAPP_HOST=0.0.0.0
HAPAPP_PORT=8050
HAPAPP_DEBUG=0

# GitHub token for private GitHub-backed species panel files.
HAPAPP_GITHUB_TOKEN=

# Optional custom panel registry path.
# HAPAPP_PANELS_FILE=/absolute/path/to/panels.toml

# Dropbox archive settings.
HAPAPP_DROPBOX_ACCESS_TOKEN=
HAPAPP_DROPBOX_MADC_FOLDER=/HapApp/MADC review
HAPAPP_DROPBOX_LOG_FOLDER=/HapApp/MADC logs
